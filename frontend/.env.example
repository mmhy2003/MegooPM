# MegooPM frontend environment.
# Copy to `.env.local` for development. All NEXT_PUBLIC_* values are exposed to
# the browser and inlined at build time.

# Base URL of the MegooPM backend API (FastAPI).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Enable route-level auth enforcement in the proxy (formerly middleware).
# Leave "false" in dev so the app shell is browsable without a session.
NEXT_PUBLIC_AUTH_ENABLED=false

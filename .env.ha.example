# MegooPM — per-NODE environment for docker-compose.ha.yml.
#
#   cp .env.ha.example .env        # on every node, then edit the node-specific lines
#
# Values marked IDENTICAL must be the same on every node; the rest are per node.

# ---------- This node ----------
# Unique, stable identifier (stamped on config-version bumps; docs/ha.md §4).
NODE_ID=node-a
# Host directory of the shared mount (NFS etc.) — mounted into the containers
# at /data. Must be writable by uid 1000 on every node (docs/ha.md §6).
SHARED_DATA_PATH=/mnt/megoopm
# Where encrypted backups are written. Under HA this MUST be shared storage —
# the same directory on every node. The worker writes on one node and the
# Backups page is served by whichever node your load balancer picked, so a
# per-node path means the file exists on disk and the UI shows nothing.
#
# Any path identical across nodes works; the shared mount is the obvious one.
# It does mean backups share that storage's fate, so copy them off-box on a
# schedule. Keep it off any web-served path: a backup holds TLS private keys
# and every stored secret, and anyone with both the file and SECRET_KEY has
# the instance.
BACKUP_PATH=/mnt/megoopm/backups
# Largest backup an admin may upload through the page, in bytes. The default
# is 4 GiB; a restore reads the whole file, so raise it only with the disk to
# match.
#BACKUP_MAX_BYTES=4294967296
# Profiles this node runs: `control-plane`, or empty on a data-plane node.
# `control-plane` hosts Postgres, Redis and CrowdSec for the whole cluster —
# exactly one node (or leave it empty everywhere and use managed services).
# Note: `beat` is NOT a profile. Every node runs one; its reconcile tick targets
# only the node it runs on, which is what bounds how long that node can serve
# stale config. Cluster-wide sweeps stay singletons via a leader lock.
COMPOSE_PROFILES=control-plane
# 1 on the node you upgrade first (applies migrations), 0 on the others.
RUN_MIGRATIONS=1
# Interface the control-plane services are published on (control-plane node only).
CONTROL_PLANE_BIND=0.0.0.0

# ---------- Shared services (IDENTICAL on every node) ----------
# On the control-plane node the hostnames are the compose service names
# (db, redis, crowdsec); on every other node use that node's address.
DATABASE_URL=postgresql+asyncpg://megoopm:CHANGE_ME@db:5432/megoopm
REDIS_URL=redis://redis:6379/0
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_APPSEC_URL=http://crowdsec:7422
# Where this node's nginx ships its logs (the control-plane CrowdSec, UDP).
CROWDSEC_SYSLOG_ADDR=crowdsec:514
# Which node runs the CrowdSec container and whose worker has the docker
# socket, so UI-authored whitelists can be applied. Set this to that node's
# NODE_ID and use the SAME value on every node — it names the control plane,
# it is not each node's own id. Leave blank to disable whitelist reloads:
# whitelists then save but the Security page reports them as not applied.
CROWDSEC_CONTROL_NODE_ID=
# Container the reload restarts (docker ps --format '{{.Names}}').
CROWDSEC_CONTAINER_NAME=megoopm-ha-crowdsec-1
# Group id of the host's docker socket, so the worker (uid 1000) may open it
# for CrowdSec reloads and hub updates. Find it with:
#   stat -c %g /var/run/docker.sock
# Recreate the worker after changing it (docker compose up -d worker).
DOCKER_GID=999
# Wait for LAPI after that restart before rolling the whitelist file back.
CROWDSEC_RELOAD_HEALTH_TIMEOUT_SECONDS=60
# Control-plane node only: what the local Postgres is initialised with (must
# match DATABASE_URL above).
POSTGRES_USER=megoopm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=megoopm

# ---------- Secrets (IDENTICAL on every node; openssl rand -hex 32) ----------
SECRET_KEY=
CROWDSEC_BOUNCER_KEY=
# LAPI auto-registration token: the cluster's machine self-registers and is
# validated automatically (control-plane LAPI reads it from the same variable).
CROWDSEC_REGISTRATION_TOKEN=
NGINX_RELOAD_TOKEN=

# ---------- Admin surface ----------
# Public URL of the API as the browser reaches it (via your LB); inlined into
# the UI at build time — `docker compose -f docker-compose.ha.yml build frontend`
# after changing it.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_AUTH_ENABLED=true
CORS_ORIGINS=https://mpm.example.com
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# ---------- Ports on this host ----------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
FRONTEND_PORT=3000
BACKEND_PORT=8000
# control-plane node only
POSTGRES_PORT=5432
REDIS_PORT=6379
CROWDSEC_LAPI_PORT=8080
CROWDSEC_APPSEC_PORT=7422
CROWDSEC_SYSLOG_PORT=514

# ---------- Client IP behind your LB / CDN ----------
# Header carrying the real client IP and the proxy ranges to trust; otherwise
# CrowdSec's log-based detections would ban the LB/CDN address itself.
NGINX_REAL_IP_HEADER=
NGINX_REAL_IP_FROM=

# ---------- TLS / ACME ----------
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ACCOUNT_EMAIL=
ACME_DNS_PROPAGATION_TIMEOUT_SECONDS=120
ACME_DNS_PROPAGATION_INTERVAL_SECONDS=5
ACME_DNS_PROPAGATION_SETTLE_SECONDS=10
# How the check reaches DNS. `auto` finds the zone's nameservers over
# DNS-over-HTTPS (port 443), so an internal resolver hosting its own copy of
# the zone cannot send it to the wrong server, then checks them on port 53 if
# that gets out and over DoH if it is firewalled. `authoritative` uses the
# local resolver and port 53 only; `doh` never uses port 53. The default
# resolvers are Cloudflare's and Google's; the names being validated are
# looked up there.
ACME_DNS_PROPAGATION_MODE=auto
# ACME_DOH_URLS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve
# Backstop reconcile cadence per node (seconds).
# How often each node reconciles itself against the shared config version.
HA_RECONCILE_INTERVAL_SECONDS=15
# TTL on a reconcile message (default: 3x the interval) and how many intervals a
# node may miss before it drops out of the push fan-out. Both optional.
# HA_RECONCILE_EXPIRES_SECONDS=45
# HA_NODE_LIVENESS_MULTIPLIER=4

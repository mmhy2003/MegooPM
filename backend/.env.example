# Copy to .env for local development. Do NOT commit a real .env.

# --- Service ---
PROJECT_NAME=MegooPM
ENVIRONMENT=development
DEBUG=true

# --- Database (async SQLAlchemy URL) ---
DATABASE_URL=postgresql+asyncpg://megoopm:megoopm@localhost:5432/megoopm
DB_ECHO=false

# --- Security ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (comma-separated, or * for all) ---
CORS_ORIGINS=http://localhost:3000

# --- Redis / Celery ---
# Default broker + result backend. CELERY_BROKER_URL / CELERY_RESULT_BACKEND
# override REDIS_URL when broker and backend must differ.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Run tasks inline without a worker/broker (tests only; keep false in deploys).
CELERY_TASK_ALWAYS_EAGER=false

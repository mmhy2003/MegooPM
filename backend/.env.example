# Copy to .env for local development. Do NOT commit a real .env.

# --- Service ---
PROJECT_NAME=MegooPM
ENVIRONMENT=development
DEBUG=true

# --- Database (async SQLAlchemy URL) ---
DATABASE_URL=postgresql+asyncpg://megoopm:megoopm@localhost:5432/megoopm
DB_ECHO=false

# --- Security ---
# Generate a strong random value in real environments (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-in-production
# JWT signing algorithm (HMAC). Access token short-lived; refresh longer-lived.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Optional bootstrap admin, consumed by `python -m scripts.create_user --from-env`.
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD=change-me

# --- CORS (comma-separated, or * for all) ---
CORS_ORIGINS=http://localhost:3000

# --- Redis / Celery ---
# Default broker + result backend. CELERY_BROKER_URL / CELERY_RESULT_BACKEND
# override REDIS_URL when broker and backend must differ.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Run tasks inline without a worker/broker (tests only; keep false in deploys).
CELERY_TASK_ALWAYS_EAGER=false

# --- Shared state root (HA / MEG-35) ---
# Single shared mount (NFS / shared volume) holding all mutable state. When the
# nginx/certs paths below are left unset they default to subdirs of this root
# (e.g. $SHARED_DATA_DIR/nginx/conf.d). Set it on every node in an HA cluster.
# SHARED_DATA_DIR=/data

# --- nginx config/reload engine ---
# Shared volume (with the nginx container) for generated vhost configs, and the
# certs directory server blocks reference. Managed files use NGINX_MANAGED_PREFIX.
# Leave unset to derive from SHARED_DATA_DIR (the compose stacks do).
# NGINX_CONFD_DIR=/data/nginx/conf.d
# NGINX_CERTS_DIR=/data/certs
NGINX_MANAGED_PREFIX=megoopm-
# Commands the engine shells out to validate and reload nginx. Defaults suit a
# host where nginx runs next to the worker.
NGINX_TEST_COMMAND=nginx -t
NGINX_RELOAD_COMMAND=nginx -s reload
# In the compose stacks both commands are `python -m scripts.nginx_remote test|reload`,
# which talks to the reload agent in the nginx container (docs/nginx-engine.md):
# NGINX_AGENT_ADDR=nginx:9099
# NGINX_RELOAD_TOKEN=

# --- TLS / ACME (Let's Encrypt) ---
# ACME directory. Defaults to Let's Encrypt STAGING (safe/unthrottled); switch
# to https://acme-v02.api.letsencrypt.org/directory for real, trusted certs.
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# Contact email for the ACME account (expiry notices, ToS).
# ACME_ACCOUNT_EMAIL=admin@example.com
# Webroot for HTTP-01 tokens; nginx serves it at /.well-known/acme-challenge/.
ACME_HTTP_CHALLENGE_DIR=/etc/nginx/certs/_acme-challenge
# Self-sign locally instead of calling ACME (dev/CI only; keep false in deploys).
ACME_SELF_SIGNED=false
# Auto-renew a certificate once within this many days of expiry (beat sweep).
CERT_RENEW_BEFORE_DAYS=30
CERT_RENEW_SWEEP_HOUR=3
CERT_RENEW_SWEEP_MINUTE=15

# --- High Availability (MEG-35) ---
# Turn on cross-node coordination: Postgres advisory lock around nginx apply, a
# shared config-version bump, reload fan-out to every node, and leader-locked
# periodic sweeps. Keep false for single-node deployments. See docs/ha.md.
HA_ENABLED=false
# Stable identifier for this node (defaults to the hostname).
# NODE_ID=node-a
# Node-LOCAL run dir for fallback lock files + the reload marker. Must NOT be on
# the shared mount — it records whether THIS node has caught up.
HA_LOCK_DIR=/var/run/megoopm
NGINX_RELOAD_MARKER_PATH=/var/run/megoopm/nginx-config.version
# How often (seconds) each node reconciles its nginx against the shared version.
HA_RECONCILE_INTERVAL_SECONDS=30

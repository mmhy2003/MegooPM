# Copy to .env for local development. Do NOT commit a real .env.

# --- Service ---
PROJECT_NAME=MegooPM
ENVIRONMENT=development
DEBUG=true

# --- Database (async SQLAlchemy URL) ---
DATABASE_URL=postgresql+asyncpg://megoopm:megoopm@localhost:5432/megoopm
DB_ECHO=false

# --- Security ---
# Generate a strong random value in real environments (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-in-production
# JWT signing algorithm (HMAC). Access token short-lived; refresh longer-lived.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Optional bootstrap admin, consumed by `python -m scripts.create_user --from-env`.
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD=change-me

# --- CORS (comma-separated, or * for all) ---
CORS_ORIGINS=http://localhost:3000

# --- Redis / Celery ---
# Default broker + result backend. CELERY_BROKER_URL / CELERY_RESULT_BACKEND
# override REDIS_URL when broker and backend must differ.
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Run tasks inline without a worker/broker (tests only; keep false in deploys).
CELERY_TASK_ALWAYS_EAGER=false

# --- nginx config/reload engine ---
# Shared volume (with the nginx container) for generated vhost configs, and the
# certs directory server blocks reference. Managed files use NGINX_MANAGED_PREFIX.
NGINX_CONFD_DIR=/etc/nginx/conf.d
NGINX_CERTS_DIR=/etc/nginx/certs
NGINX_MANAGED_PREFIX=megoopm-
# Commands the engine shells out to validate and reload nginx. Override for a
# split topology (e.g. a docker-exec/SSH shim that reaches the nginx container).
NGINX_TEST_COMMAND=nginx -t
NGINX_RELOAD_COMMAND=nginx -s reload

# --- TLS / ACME (Let's Encrypt) ---
# ACME directory. Defaults to Let's Encrypt STAGING (safe/unthrottled); switch
# to https://acme-v02.api.letsencrypt.org/directory for real, trusted certs.
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# Contact email for the ACME account (expiry notices, ToS).
# ACME_ACCOUNT_EMAIL=admin@example.com
# Webroot for HTTP-01 tokens; nginx serves it at /.well-known/acme-challenge/.
ACME_HTTP_CHALLENGE_DIR=/etc/nginx/certs/_acme-challenge
# Self-sign locally instead of calling ACME (dev/CI only; keep false in deploys).
ACME_SELF_SIGNED=false
# Auto-renew a certificate once within this many days of expiry (beat sweep).
CERT_RENEW_BEFORE_DAYS=30
CERT_RENEW_SWEEP_HOUR=3
CERT_RENEW_SWEEP_MINUTE=15

{# Renders the `server {}` block(s) for one MegooPM proxy host.

   - No certificate      -> a single plain :80 server.
   - Certificate present -> a :443 TLS server, plus a :80 server that either
     redirects to HTTPS (ssl_forced) or serves the proxy directly.

   Shared fragments live in macros so the proxy body is defined once. #}
{%- macro proxy_block(path, scheme, target, modifier="") %}
    location {{ modifier }}{{ path }} {
        proxy_pass {{ scheme }}://{{ target }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
{%- if host.allow_websocket_upgrade %}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{%- endif %}
{%- if host.access_list and host.access_list.auth_users and not host.access_list.pass_auth %}
        # Access list consumes the basic-auth header; do not forward it upstream.
        proxy_set_header Authorization "";
{%- endif %}
    }
{%- endmacro -%}
{%- macro proxy_location() %}
{{- proxy_block("/", host.forward_scheme, target) }}
{%- for loc in host.locations %}

    # Extra route: ^~ makes the longest prefix win over the cache-assets regex.
{{- proxy_block(loc.path, loc.forward_scheme, location_pools[loc.upstream_id], "^~ ") }}
{%- endfor %}
{%- if host.caching_enabled %}

    location ~* \.(?:jpg|jpeg|gif|png|ico|css|js|woff2?|svg)$ {
        proxy_pass {{ host.forward_scheme }}://{{ target }};
        proxy_set_header Host $host;
        expires 1d;
        add_header Cache-Control "public";
    }
{%- endif %}
{%- endmacro -%}
{%- macro security() -%}
{%- if host.block_exploits %}
    # Block common exploit probes.
    if ($request_uri ~* "(<|%3C).*script.*(>|%3E)") { return 403; }
    if ($request_uri ~* "(\.\./|\.\.%2f)") { return 403; }
    if ($query_string ~* "union.*select.*\(") { return 403; }
{%- endif %}
{%- endmacro -%}
{%- macro hsts() -%}
{%- if host.hsts_enabled %}
    add_header Strict-Transport-Security "max-age=63072000{% if host.hsts_subdomains %}; includeSubDomains{% endif %}" always;
{%- endif %}
{%- endmacro -%}
{%- macro crowdsec() -%}
{%- if host.crowdsec_enabled %}
    # CrowdSec bouncer (MEG-22). Runs in the access phase: banned IPs are refused
    # before the request reaches the upstream. AppSec/WAF, when the engine is
    # configured, is currently GLOBAL (applies to every crowdsec-enabled host),
    # so $megoopm_crowdsec_appsec is a reserved marker the handler does not yet
    # gate on — see docs/crowdsec.md (MEG-32 / D3).
    set $megoopm_crowdsec_appsec {% if host.crowdsec_appsec_enabled %}on{% else %}off{% endif %};
    access_by_lua_file /etc/nginx/lua/megoopm_crowdsec.lua;
{%- endif %}
{%- endmacro -%}
{%- macro access_control() -%}
{%- if host.access_list %}
    # Access list "{{ host.access_list.name }}" (MEG-21).
{%- if htpasswd_path %}
    auth_basic "{{ host.access_list.name }}";
    auth_basic_user_file {{ htpasswd_path }};
{%- endif %}
{%- for rule in host.access_list.client_rules %}
    {{ rule.directive }} {{ rule.address }};
{%- endfor %}
{%- if htpasswd_path and host.access_list.client_rules %}
    # Pass if EITHER gate is satisfied (any) or require BOTH (all).
    satisfy {{ 'any' if host.access_list.satisfy_any else 'all' }};
{%- endif %}
{%- endif %}
{%- endmacro -%}
{%- macro acme_challenge() %}

    # ACME HTTP-01 challenge webroot (Let's Encrypt issuance/renewal, MEG-19).
    # Kept ahead of any HTTPS redirect so validation succeeds on ssl-forced
    # hosts; `alias` maps the token URL straight onto the shared challenge dir.
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        alias {{ acme_challenge_root }}/;
{%- if host.access_list %}
        # Challenge must stay reachable even when the host is access-controlled.
        auth_basic off;
        allow all;
{%- endif %}
    }
{%- endmacro -%}
# Managed by MegooPM — do not edit by hand.
# proxy host id={{ host.id }}
{%- if host.certificate %}
server {
    listen 80;
    server_name {{ server_names }};
{{- crowdsec() }}
{{- acme_challenge() }}
{%- if host.ssl_forced %}

    location / {
        return 301 https://$host$request_uri;
    }
{%- else %}
{{- access_control() }}
{{- security() }}
{{- proxy_location() }}
{%- endif %}
}

server {
    listen 443 ssl{% if host.http2_support %} http2{% endif %};
    server_name {{ server_names }};

    # Renewal rewrites the files below in place, so without this line the
    # rendered config would be unchanged and no node would reload onto the new
    # certificate. See CertificateSpec.fingerprint.
    # cert-material {{ host.certificate.id }}:{{ host.certificate.fingerprint }}
    ssl_certificate {{ host.certificate.fullchain_path }};
    ssl_certificate_key {{ host.certificate.privkey_path }};
{{- hsts() }}
{{- crowdsec() }}
{{- access_control() }}
{{- security() }}
{{- proxy_location() }}
{%- if host.advanced_config %}

    {{ host.advanced_config | indent(4) }}
{%- endif %}
}
{%- else %}
server {
    listen 80;
    server_name {{ server_names }};
{{- crowdsec() }}
{{- acme_challenge() }}
{{- access_control() }}
{{- security() }}
{{- proxy_location() }}
{%- if host.advanced_config %}

    {{ host.advanced_config | indent(4) }}
{%- endif %}
}
{%- endif %}

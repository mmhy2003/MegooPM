{# Renders the `server {}` block(s) for one MegooPM dead (404) host.

   The host claims a set of domains and returns 404 for every request — a way to
   explicitly park a domain (optionally under TLS) without forwarding anywhere.

   - No certificate      -> a single plain :80 server returning 404.
   - Certificate present -> a :443 TLS server returning 404, plus a :80 server
     that either redirects to HTTPS (ssl_forced) or returns 404 directly. #}
{%- macro crowdsec() -%}
{%- if host.crowdsec_enabled %}
    # CrowdSec bouncer, in the server-rewrite phase: this server answers with
    # `return`, which runs before the access phase proxy hosts use.
    server_rewrite_by_lua_file /etc/nginx/lua/megoopm_crowdsec.lua;
{%- endif %}
{%- endmacro -%}
{%- macro dead_location() %}

    location / {
        return 404;
    }
{%- endmacro -%}
{%- macro hsts() -%}
{%- if host.hsts_enabled %}
    add_header Strict-Transport-Security "max-age=63072000{% if host.hsts_subdomains %}; includeSubDomains{% endif %}" always;
{%- endif %}
{%- endmacro -%}
{%- macro acme_challenge() %}

    # ACME HTTP-01 challenge webroot (Let's Encrypt issuance/renewal, MEG-19).
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        alias {{ acme_challenge_root }}/;
    }
{%- endmacro -%}
# Managed by MegooPM — do not edit by hand.
# dead host id={{ host.id }}
{%- if host.certificate %}
server {
    # Branded error pages for the statuses nginx itself produces. A status
    # the backend returns is untouched: there is no proxy_intercept_errors.
    include {{ default_dir }}/{{ errors_conf }};
    listen 80;
    server_name {{ server_names }};
{{- crowdsec() }}
{{- acme_challenge() }}
{%- if host.ssl_forced %}

    location / {
        return 301 https://$host$request_uri;
    }
{%- else %}
{{- dead_location() }}
{%- endif %}
}

server {
    # Branded error pages for the statuses nginx itself produces. A status
    # the backend returns is untouched: there is no proxy_intercept_errors.
    include {{ default_dir }}/{{ errors_conf }};
    listen 443 ssl;
{%- if host.http2_support %}
    http2 on;
{%- endif %}
    server_name {{ server_names }};
{{- crowdsec() }}

    ssl_certificate {{ host.certificate.fullchain_path }};
    ssl_certificate_key {{ host.certificate.privkey_path }};
{{- hsts() }}
{{- dead_location() }}
{%- if host.advanced_config %}

    {{ host.advanced_config | indent(4) }}
{%- endif %}
}
{%- else %}
server {
    # Branded error pages for the statuses nginx itself produces. A status
    # the backend returns is untouched: there is no proxy_intercept_errors.
    include {{ default_dir }}/{{ errors_conf }};
    listen 80;
    server_name {{ server_names }};
{{- crowdsec() }}
{{- acme_challenge() }}
{{- dead_location() }}
{%- if host.advanced_config %}

    {{ host.advanced_config | indent(4) }}
{%- endif %}
}
{%- endif %}

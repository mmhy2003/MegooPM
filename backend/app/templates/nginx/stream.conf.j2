{# Renders one MegooPM stream (raw TCP/UDP port forward).

   This file is included from the top-level `stream {}` context (NOT `http {}`),
   so it contains a bare `server {}` with stream directives only.

   - tcp_forwarding -> `listen <port>;` (plus `ssl` when a certificate is set,
     terminating TLS on the TCP listener).
   - udp_forwarding -> `listen <port> udp;` (UDP cannot terminate TLS).
   At least one protocol is always enabled (DB check constraint). #}
# Managed by MegooPM — do not edit by hand.
# stream id={{ stream.id }} — {{ stream.incoming_port }} -> {% if stream.upstream_id %}pool {{ pool_name }}{% else %}{{ stream.forward_host }}:{{ stream.forward_port }}{% endif %}
server {
{%- if stream.tcp_forwarding %}
    listen {{ stream.incoming_port }}{% if stream.certificate %} ssl{% endif %};
{%- endif %}
{%- if stream.udp_forwarding %}
    listen {{ stream.incoming_port }} udp;
{%- endif %}
{%- if stream.certificate %}

    ssl_certificate {{ stream.certificate.fullchain_path }};
    ssl_certificate_key {{ stream.certificate.privkey_path }};
{%- endif %}

{%- if stream.upstream_id %}
    proxy_pass {{ pool_name }};
{%- else %}
    proxy_pass {{ stream.forward_host }}:{{ stream.forward_port }};
{%- endif %}
}

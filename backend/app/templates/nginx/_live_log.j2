{# The live log directives every generated server block carries (docs/live-logs.md).

   Lines go to the loopback relay on this node, which publishes the watched ones
   to Redis pub/sub; nothing is stored. The host key: p<id> proxy,
   r<id> redirection, d<id> dead, s<id> stream, u unclaimed.

   Access lines go out through ONE access log at the http (stream) level, which
   every block inherits: a syslog target is a socket in each worker, so one per
   block would cost a socket per host. The line carries the key in `$mgm_key`,
   set here. Error lines carry no variables, so the error log stays per block,
   tagged `mgm_<key>`; declaring it stops the block inheriting the http-level
   error targets, so the include restates those (and only those) first.

   A server whose CrowdSec bouncer runs in the server-rewrite phase ends a
   denied request before these `set`s run. Its bouncer hook sets `$mgm_key`
   itself (see the templates' crowdsec macros); `bounces` silences the warning
   nginx would otherwise log for the unassigned `$mgm_cs` (empty, which is
   right) on every denied request. #}
{%- macro live_log(key, bounces=false) %}

    # Live logs: lines go to the loopback relay and are stored nowhere (docs/live-logs.md).
    set $mgm_key {{ key }};
    set $mgm_cs "";
{%- if bounces %}
    # Server-wide, not just this variable: the bouncer ends a denied request
    # before the line above runs, and the warning would be logged for each one.
    uninitialized_variable_warn off;
{%- endif %}
    include /etc/nginx/logging-error-targets.conf;
    error_log syslog:server=127.0.0.1:5140,tag=mgm_{{ key }},nohostname info;
{%- endmacro -%}
{#- Stream form. No include: the targets files are http{} directives. The error
    log is the one target a stream server loses by declaring its own, so it is
    restated (the same file the http targets use). -#}
{%- macro live_stream_log(key) %}

    # Live logs: lines go to the loopback relay and are stored nowhere (docs/live-logs.md).
    # A stream line is written when the connection closes.
    set $mgm_key {{ key }};
    error_log /usr/local/openresty/nginx/logs/error.log warn;
    error_log syslog:server=127.0.0.1:5140,tag=mgm_{{ key }},nohostname info;
{%- endmacro -%}
{#- The CrowdSec hook for a server that bounces in the server-rewrite phase. It
    runs before this server's `set $mgm_key`, and a denial ends the request
    there, so the hook names the key itself: the denied request's line must
    still say which host it was. -#}
{%- macro crowdsec_server_rewrite(key) %}
    server_rewrite_by_lua_block { require("megoopm_crowdsec_check").check("{{ key }}") }
{%- endmacro -%}

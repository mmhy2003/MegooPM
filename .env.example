# MegooPM — full-stack local dev environment.
#
# Copy to `.env` (docker compose reads it automatically):
#
#   cp .env.example .env
#
# Every value here mirrors a default already baked into docker-compose.yml, so
# `docker compose up` works even without a `.env`. Copy the file when you want
# to change ports, credentials, or the API base URL.

# ---------- Postgres ----------
POSTGRES_USER=megoopm
POSTGRES_PASSWORD=megoopm
POSTGRES_DB=megoopm
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Backend (FastAPI + Celery) ----------
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true
# Never commit a real secret. Override in deployed environments.
SECRET_KEY=change-me-in-production
# Comma-separated origins; must include the frontend origin below.
CORS_ORIGINS=http://localhost:3000
# Initial-setup admin: seeded on first start ONLY while the users table is
# empty. Log in with these, then change the password (or set your own here
# before the first `docker compose up`). Deleting the account later is safe —
# it is never re-created once any user exists.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme

# ---------- Frontend (Next.js) ----------
FRONTEND_PORT=3000
# Browser-facing: points at the backend's published host port (not the
# in-network `backend` hostname, which the browser cannot resolve).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_ENABLED=false

# ---------- Managed nginx proxy ----------
# Host ports the proxy MegooPM controls listens on.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# ---------- CrowdSec security engine (MEG-22, MEG-43) ----------
# Bouncer API key shared by CrowdSec (which registers it) and the nginx bouncer
# + backend decision reads. Dev default is fine locally; use a real secret in
# deployed stacks. Read/enforce paths (decisions + per-host bouncer/AppSec) work
# with just this key.
CROWDSEC_BOUNCER_KEY=megoopm-dev-bouncer-key
# Machine credentials for the alert read + manual-decision write paths. These
# are now DB-backed and OPTIONAL: on first use the backend self-registers its
# own LAPI machine and stores the creds encrypted in Postgres (Fernet, keyed off
# SECRET_KEY), so no manual `cscli machines add` is required. Setting both on a
# fresh DB seeds them in once (upgrade path for env-configured stacks); leaving
# them blank lets auto-registration provision the machine. NOTE: whether the new
# machine is usable immediately depends on the LAPI's `auto_registration` config
# — otherwise an operator runs `cscli machines validate <id>` once. See
# docs/crowdsec.md.
CROWDSEC_MACHINE_ID=
CROWDSEC_MACHINE_PASSWORD=

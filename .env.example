# MegooPM — full-stack local dev environment.
#
# Copy to `.env` (docker compose reads it automatically):
#
#   cp .env.example .env
#
# Every value here mirrors a default already baked into docker-compose.yml, so
# `docker compose up` works even without a `.env`. Copy the file when you want
# to change ports, credentials, or the API base URL.

# ---------- Postgres ----------
POSTGRES_USER=megoopm
POSTGRES_PASSWORD=megoopm
POSTGRES_DB=megoopm
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Backend (FastAPI + Celery) ----------
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true
# Never commit a real secret. Override in deployed environments.
SECRET_KEY=change-me-in-production
# Comma-separated origins; must include the frontend origin below.
CORS_ORIGINS=http://localhost:3000

# ---------- Frontend (Next.js) ----------
FRONTEND_PORT=3000
# Browser-facing: points at the backend's published host port (not the
# in-network `backend` hostname, which the browser cannot resolve).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_ENABLED=false

# ---------- Managed nginx proxy ----------
# Host ports the proxy MegooPM controls listens on.
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
